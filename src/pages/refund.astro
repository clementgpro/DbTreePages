---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Providers from '@/components/Providers';
import Refund from '@/views/Refund';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dbtree.app/" },
    { "@type": "ListItem", "position": 2, "name": "Refund Policy", "item": "https://dbtree.app/refund" }
  ]
});
---

<BaseLayout
  title="Refund Policy - DbTree"
  description="Read the Refund Policy for DbTree. We offer a fair refund policy for our customers."
  schema={breadcrumbSchema}
>
  <Providers client:load>
    <Refund client:load />
  </Providers>
</BaseLayout>
