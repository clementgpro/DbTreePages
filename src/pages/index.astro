---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Providers from '@/components/Providers';
import Index from '@/views/Index';

const pageSchemas = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "DbTree",
    "url": "https://dbtree.app",
    "description": "DbTree shows your PostgreSQL database as an interactive tree. Follow foreign keys in both directions and expand related records with one click, without writing JOINs.",
    "applicationCategory": "DeveloperApplication",
    "applicationSubCategory": "DatabaseApplication",
    "operatingSystem": "Windows 10, Windows 11",
    "softwareVersion": "1.0.0",
    "releaseNotes": "https://dbtree.app/download",
    "downloadUrl": "https://github.com/clementgpro/DbTreePages/releases/download/1.0.0/DbTree.zip",
    "installUrl": "https://dbtree.app/download",
    "screenshot": "https://dbtree.app/hero-screenshot.jpg",
    "featureList": [
      "Hierarchical tree visualization of relational database relationships",
      "PostgreSQL 9.6+ support",
      "Read-only mode — no data modification",
      "Lazy loading for large datasets",
      "Foreign key auto-detection",
      "One-click record details panel",
      "No Java required — standalone installer"
    ],
    "author": {
      "@type": "Organization",
      "name": "DbTree",
      "url": "https://dbtree.app",
      "email": "contact.dbtree@gmail.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "DbTree",
      "url": "https://dbtree.app"
    },
    "offers": [
      {
        "@type": "Offer",
        "name": "Free",
        "price": "0",
        "priceCurrency": "EUR",
        "description": "Limited to 2 hierarchical levels. No credit card required.",
        "url": "https://dbtree.app/download",
        "availability": "https://schema.org/InStock"
      },
      {
        "@type": "Offer",
        "name": "Lifetime",
        "price": "29",
        "priceCurrency": "EUR",
        "description": "One-time payment. Lifetime license. Unlimited hierarchical levels.",
        "url": "https://dbtree.app/download",
        "availability": "https://schema.org/InStock"
      }
    ],
    "datePublished": "2026-01-10",
    "inLanguage": "en",
    "license": "https://dbtree.app/terms",
    "isAccessibleForFree": true,
    "potentialAction": {
      "@type": "DownloadAction",
      "target": "https://github.com/clementgpro/DbTreePages/releases/download/1.0.0/DbTree.zip"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Which databases does DbTree support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "DbTree currently supports PostgreSQL version 9.6 and above, including cloud-hosted PostgreSQL on Amazon RDS, Supabase, Neon, and Railway. The connection uses a standard PostgreSQL driver in read-only mode. Support for MySQL, MariaDB, SQLite, and Microsoft SQL Server is on the roadmap. All database credentials are stored locally on your machine and never transmitted to DbTree's servers."
        }
      },
      {
        "@type": "Question",
        "name": "Is my database data safe with DbTree?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. DbTree operates exclusively in read-only mode and never modifies, stores, or transmits your database data. All connections are made directly from your local machine to your database server — nothing passes through DbTree's infrastructure. Your database credentials are stored locally on your machine only. You can explore your data with complete confidence that nothing will be changed."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use DbTree on Mac or Linux?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The current version of DbTree is optimized for Windows 10 and Windows 11 (x64). The application is distributed as a portable zip — no installation required, just extract and run. Mac and Linux versions are actively in development and coming soon. Sign up or check back on the download page for release announcements."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to install Java to run DbTree?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. DbTree is a fully standalone application — the portable Windows zip includes the runtime and everything you need. Simply download the zip, extract it anywhere, and double-click the executable. No Java, no .NET framework, and no additional installations required. Minimum requirements: Windows 10 x64, 4 GB RAM, 100 MB disk space."
        }
      },
      {
        "@type": "Question",
        "name": "Can I try DbTree for free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The Free plan is available at no cost with no credit card required. It includes all core features — tree visualization, foreign key navigation, record details, and lazy loading — with navigation limited to 2 hierarchical levels. Get the Lifetime license (€29 one-time payment) for permanent, unlimited hierarchical exploration."
        }
      }
    ]
  }
]);
---

<BaseLayout
  title="DbTree - Explore PostgreSQL Relationships as a Tree"
  description="DbTree shows your PostgreSQL database as an interactive tree. Follow foreign keys in both directions and expand related records with one click, without writing JOINs."
  schema={pageSchemas}
>
  <Providers client:load>
    <Index client:load />
  </Providers>
</BaseLayout>
