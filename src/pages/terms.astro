---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Providers from '@/components/Providers';
import Terms from '@/views/Terms';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dbtree.app/" },
    { "@type": "ListItem", "position": 2, "name": "Terms of Service", "item": "https://dbtree.app/terms" }
  ]
});
---

<BaseLayout
  title="Terms of Service - DbTree"
  description="Read the Terms of Service for DbTree, the SQL tree explorer desktop application."
  schema={breadcrumbSchema}
>
  <Providers client:load>
    <Terms client:load />
  </Providers>
</BaseLayout>
