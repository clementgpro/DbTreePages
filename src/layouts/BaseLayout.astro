---
import '@/index.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  schema?: string;
}

const {
  title = 'DbTree — Explore your database as a tree',
  description = 'The first desktop SQL client designed to visualize your relational databases as an intuitive hierarchical tree. Forget mental JOINs, click and expand your relationships instantly.',
  ogImage = '/hero-screenshot.jpg',
  canonicalUrl,
  schema,
} = Astro.props;

const siteUrl = 'https://dbtree.app';
const canonical = canonicalUrl ?? siteUrl + Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + ogImage} />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="oJCVvg2uJYqQBLw-XHYpJk6xVX-EQ2WmeShfzxU0698" />

    <!-- Sitewide Schema: WebSite + Organization -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://dbtree.app/#website",
          "name": "DbTree",
          "url": "https://dbtree.app",
          "description": "The first desktop SQL client that visualizes relational databases as hierarchical trees.",
          "inLanguage": "en"
        },
        {
          "@type": "Organization",
          "@id": "https://dbtree.app/#organization",
          "name": "DbTree",
          "url": "https://dbtree.app",
          "logo": {
            "@type": "ImageObject",
            "url": "https://dbtree.app/app-icon.png",
            "width": 512,
            "height": 512
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "contact.dbtree@gmail.com",
            "contactType": "customer support",
            "availableLanguage": ["English"]
          },
          "sameAs": []
        }
      ]
    }
    </script>

    <!-- Page-specific schema (injected by individual pages) -->
    {schema && <script type="application/ld+json" set:html={schema} />}

    <!--
      CRITICAL CSS — inlined to avoid render-blocking.
      Contains only the variables and base styles needed before
      the main stylesheet is parsed (prevents FOUC on LCP element).
    -->
    <style>
      :root {
        --background: 220 20% 4%;
        --foreground: 210 20% 95%;
        --primary: 205 70% 54%;
        --primary-foreground: 210 20% 98%;
        --font-body: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', sans-serif;
        --font-display: 'Space Grotesk Variable', 'Space Grotesk', sans-serif;
      }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background-color: hsl(220 20% 4%);
        color: hsl(210 20% 95%);
        font-family: var(--font-body);
      }
    </style>

    <!-- Umami Analytics — defer: non-blocking, but available before first interaction -->
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="01f867db-00b1-4df1-a652-4782804f5c08"
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>

